<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1" fx:id="rootPane" fx:controller="com.ravi.notesapp.controller.MainController" styleClass="root-pane">

    <!-- ==================== HEADER ==================== -->
    <top>
        <VBox>
            <!-- ==================== TOOLBAR ==================== -->
            <ToolBar fx:id="toolBar" styleClass="tool-bar">
                <ToggleButton fx:id="btnToggleSidebar" onAction="#onToggleSidebar" styleClass="toolbar-btn">
                    <tooltip>
                        <Tooltip text="Toggle Sidebar (Ctrl+B)"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 2v12h4V6H4z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </ToggleButton>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnOpen" text="Open" onAction="#onOpenFolder" styleClass="toolbar-btn" graphicTextGap="4">
                    <tooltip>
                        <Tooltip text="Open Folder (Ctrl+O)"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnSave" text="Save" onAction="#onSave" styleClass="toolbar-btn" graphicTextGap="4">
                    <tooltip>
                        <Tooltip text="Save Active File (Ctrl+S)"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </Button>

                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnNewFile" onAction="#onNewFile" styleClass="toolbar-btn">
                    <tooltip>
                        <Tooltip text="New File (Ctrl+N)"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnNewDir" onAction="#onNewFolder" styleClass="toolbar-btn">
                    <tooltip>
                        <Tooltip text="New Folder (Ctrl+Shift+N)"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2zm8 10h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnDelete" onAction="#onDelete" styleClass="toolbar-btn">
                    <tooltip>
                        <Tooltip text="Move to Recycle Bin (Del)"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnSearch" onAction="#onFind" styleClass="toolbar-btn">
                    <tooltip>
                        <Tooltip text="Find in File (Ctrl+F)"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnTheme" onAction="#onToggleTheme" styleClass="toolbar-btn">
                    <tooltip>
                        <Tooltip text="Toggle Theme (Ctrl+Shift+T)"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8v16z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnAbout" onAction="#onAbout" styleClass="toolbar-btn">
                    <tooltip>
                        <Tooltip text="About Notepad_Pro"/>
                    </tooltip>
                    <graphic>
                        <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z M0 0 H0.01 M24 24 H23.99" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>

                <ToggleButton fx:id="btnToggleAi" text="Ai" onAction="#onToggleAi" styleClass="toolbar-btn" style="-fx-font-weight: bold; -fx-font-size: 14px;">
                    <tooltip>
                        <Tooltip text="Toggle AI Assistant (Ctrl+J)"/>
                    </tooltip>
                </ToggleButton>

                <MenuButton fx:id="btnMoreOptions" text="☰" styleClass="toolbar-btn">
                    <items>
                        <MenuItem text="Open File..." onAction="#onOpenFile"/>
                        <Menu fx:id="menuRecent" text="Open Recent"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Save All" onAction="#onSaveAll"/>
                        <CheckMenuItem fx:id="menuAutoSave" text="Auto Save" onAction="#onToggleAutoSave"/>
                        <MenuItem text="Close Saved Tabs" onAction="#onCloseSaved"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Find in Files..." onAction="#onFindInFiles"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="Exit" onAction="#onExit"/>
                    </items>
                </MenuButton>
            </ToolBar>
        </VBox>
    </top>

    <!-- ==================== MAIN SPLIT ==================== -->
    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.22" styleClass="main-split">

            <!-- LEFT: Explorer panel -->
            <fx:include fx:id="explorerPane" source="explorer.fxml"/>

            <!-- RIGHT: Editor panel -->
            <fx:include fx:id="editorPane" source="editor.fxml"/>

            <!-- FAR RIGHT: AI Chat panel -->
            <fx:include fx:id="aiChatPane" source="ai_chat.fxml"/>

        </SplitPane>
    </center>

    <!-- ==================== STATUS BAR ==================== -->
    <bottom>
        <HBox fx:id="statusBar" styleClass="status-bar" alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="4" right="12" bottom="4" left="12"/>
            </padding>
            <Label fx:id="lblStatus" text="Ready" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblFileInfo" text="" styleClass="status-meta"/>
        </HBox>
    </bottom>


</BorderPane>
