<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ravi.notesapp.controller.AIChatController" styleClass="ai-panel" minWidth="240" prefWidth="300">

    <HBox styleClass="explorer-header" alignment="CENTER_LEFT" spacing="6">
        <padding>
            <Insets top="4" right="8" bottom="4" left="10"/>
        </padding>
        <Label text="AI ASSISTANT" styleClass="panel-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button styleClass="icon-btn" onAction="#onSettings" style="-fx-padding: 4; -fx-cursor: hand; -fx-background-color: transparent;">
