            </graphic>
            <tooltip>
                <Tooltip text="AI Settings (API Key)"/>
            </tooltip>
        </Button>
    </HBox>

    <javafx.scene.web.WebView fx:id="chatWebView" VBox.vgrow="ALWAYS" />

    <HBox spacing="8" alignment="CENTER" styleClass="chat-input-container">
        <padding>
            <Insets top="8" right="8" bottom="4" left="8"/>
        </padding>
        <TextArea fx:id="promptArea" promptText="Ask Redix..." wrapText="true" prefRowCount="2" HBox.hgrow="ALWAYS" styleClass="chat-input" onKeyPressed="#onPromptKeyPressed"/>
        <Button fx:id="sendBtn" onAction="#onSend" styleClass="chat-send-btn">
            <graphic>
                <javafx.scene.shape.SVGPath content="M22 2L11 13M22 2L15 22L11 13L2 9L22 2Z" fill="transparent" stroke="white" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" scaleX="0.75" scaleY="0.75" />
            </graphic>
        </Button>

    </HBox>
</VBox>
